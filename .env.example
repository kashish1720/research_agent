# API Keys and provider configurations
# Any Settings field can be overridden by its UPPERCASE name
TAVILY_API_KEY=

# LLM_PROVIDER is one of gemini|openai|anthropic and is decided in Prompt 4
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_CHEAP=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-120b

# Fault injection configuration
FAULT_INJECT=

# Search and path defaults
SEARCH_PROVIDERS=tavily,ddgs
LOG_DIR=logs
RUNS_DIR=runs

# PRICE_* variables are optional for cost estimates
# PRICE_IN_PER_MTOK_CHEAP=
# PRICE_OUT_PER_MTOK_CHEAP=
# PRICE_IN_PER_MTOK_STRONG=
# PRICE_OUT_PER_MTOK_STRONG=

MAX_SUBQUESTIONS=4
MAX_SEARCHES=6
MAX_FETCHES=8